{:graph/name "vega",
 :nodes
 [{:id "01-vega-spec",
   :label "vega symbol spec",
   :type :value,
   :show? false,
   :position {:x 24, :y 60},
   :value
   {:$schema "https://vega.github.io/schema/vega/v5.json"
    :width 400
    :height 250
    :padding {:top 10, :left 55, :bottom 40, :right 10}
    :data [{:name "table",
            :values [{:x 0, :y 7} {:x 1, :y 8} {:x 2, :y 7}
                     {:x 3, :y 4} {:x 4, :y 6}]}]
    :marks [{:type "symbol"
             :from {:data "table"}
             :encode {:enter {:x {:scale "x", :field "x"}
                              :y {:scale "y", :field "y"}
                              :fill {:value "steelblue"}
                              :fillOpacity {:value 1}}
                      :update {:shape "circle"
                               :size {:value 70}
                               :stroke {:value "transparent"}}
                      :hover {:size {:value 210}
                              :stroke {:value "white"}}}}]
    :scales [{:name "x", :type "linear", :range "width", :zero false
              :domain {:data "table", :field "x"}}
             {:name "y", :type "linear", :range "height", :nice true, :zero false
              :domain {:data "table", :field "y"}}]
    :axes [{:orient "bottom", :scale "x"}
           {:orient "left", :scale "y"}]}}
  {:id "02-vegalite-spec",
   :label "vegalite nav spec",
   :type :value,
   :show? false,
   :position {:x 24, :y 360},
   :value
   {:width 500
    :height 300
    :description "NAV Plot"
    :mark "line"
    :encoding {:x {:field "index", :type "ordinal"}
               :y {:field "nav", :type "quantitative"}}}}
  {:id "03-nav-rows",
   :label "nav rows",
   :type :value,
   :show? false,
   :position {:x 24, :y 540},
   :value
   [{:nav 100.0, :index 1}
    {:nav 120.0, :index 2}
    {:nav 150.0, :index 3}
    {:nav 120.0, :index 4}
    {:nav 140.0, :index 5}
    {:nav 150.0, :index 6}
    {:nav 160.0, :index 7}
    {:nav 150.0, :index 8}]}
  {:id "04-vega",
   :label "vega",
   :type :formula,
   :show? true,
   :position {:x 420, :y 60},
   :code
   "(fn [ctx spec]\n  ((requiring-resolve 'itera.plot.vega/vega)\n   {:spec spec\n    :embed-opts {:theme \"quartz\"}\n    :style {:width \"100%\" :height \"400px\"}}))"}
  {:id "05-vegalite",
   :label "vegalite",
   :type :formula,
   :show? true,
   :position {:x 420, :y 420},
   :code
   "(fn [ctx spec data]\n  ((requiring-resolve 'itera.plot.vega/vegalite)\n   {:spec spec\n    :data data\n    :embed-opts {:theme \"quartz\"}\n    :style {:width \"100%\" :height \"400px\"}}))"}],
 :edges
 [{:id "e1",
   :source-node "01-vega-spec",
   :source-port "out",
   :target-node "04-vega",
   :target-port "spec"}
  {:id "e2",
   :source-node "02-vegalite-spec",
   :source-port "out",
   :target-node "05-vegalite",
   :target-port "spec"}
  {:id "e3",
   :source-node "03-nav-rows",
   :source-port "out",
   :target-node "05-vegalite",
   :target-port "data"}]}