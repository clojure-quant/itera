{:graph/name "rtable",
 :ns-data
 "(ns itera.user.rtable\n  (:require [clojure.data.csv :as csv]\n            [clojure.java.io :as io]\n            [itera.plot.rtable-format-ui :as rtable-fmt]\n            [itera.util.color :as color]\n            [itera.util.fas :refer [fas]]))\n\n;; These defmethods register process-globally; re-evaluating this ns-data\n;; replaces the methods with the same dispatch keys.\n(def age-style\n  {:text-align \"right\"\n   :display \"block\"\n   :width \"2cm\"\n   :max-width \"2cm\"\n   :overflow \"hidden\"\n   :text-overflow \"ellipsis\"\n   :white-space \"nowrap\"})\n\n(defn age-color [age]\n  (assoc age-style\n         :background-color\n         (color/set-color (cond\n                            (< age 18) \"red-2\"\n                            (< age 65) \"green-2\"\n                            :else      \"blue-2\"))))\n\n(defmethod rtable-fmt/style-rtable-col :age-color [_ value]\n  {:style (age-color value)})\n\n(defn fmt-sex [sex]\n  (if (= sex :woman)\n    [:span (fas :fa-user-nurse) \" Woman\"]\n    [:span (fas :fa-user) \" Man\"]))\n\n(defmethod rtable-fmt/format-rtable-col :sex-icon [_ _ value]\n  (fmt-sex value))\n\n(def ^:private bars*\n  (delay\n    (with-open [r (io/reader (io/resource \"public/data/bars-1m-full.csv\"))]\n      (let [[header & rows] (csv/read-csv r)\n            idx (zipmap (map keyword header) (range))]\n        (mapv (fn [row]\n                {:date   (java.time.Instant/parse (nth row (idx :date)))\n                 :close  (Double/parseDouble (nth row (idx :close)))\n                 :volume (Double/parseDouble (nth row (idx :volume)))})\n              rows)))))\n\n(defn bars-rows []\n  (take 100 @bars*))\n\n(defn simple-rows []\n  [{:close 10.444 :sma 10}\n   {:close 14 :sma 12}\n   {:close 9 :sma 11}\n   {:close 16 :sma 13}\n   {:close 11 :sma 12}\n   {:close 10 :sma 11}])\n\n(defn- person\n  \"One generated person; the values mirror the demo persons dataset.\"\n  [^java.util.Random r i]\n  {:id i\n   :first-name \"John\"\n   :last-name (str \"Doe \" i)\n   :desc (str \"Person \" i \" description\")\n   :age (* 100.0 (.nextDouble r))\n   :sex (if (< (.nextDouble r) 0.5) :man :woman)\n   :x (* 100.0 (.nextDouble r))\n   :y (* 100.0 (.nextDouble r))\n   :z (* 100.0 (.nextDouble r))\n   :a (* 100.0 (.nextDouble r))\n   :b (* 100.0 (.nextDouble r))\n   :c (* 100.0 (.nextDouble r))\n   :1 (* 100.0 (.nextDouble r))\n   :2 (* 100.0 (.nextDouble r))\n   :3 (* 100.0 (.nextDouble r))})\n\n(defn persons []\n  (let [r (java.util.Random. 42)]\n    (mapv #(person r %) (range 1000))))\n",
 :nodes
 [{:id "bars-data",
   :label "bars",
   :type :formula,
   :show? true,
   :position {:x 240, :y 60},
   :code "(fn []\n  (bars-rows))"}
  {:id "simple-data",
   :label "simple rows",
   :type :formula,
   :show? false,
   :position {:x 240, :y 300},
   :code "(fn []\n  (simple-rows))"}
  {:id "persons-data",
   :label "persons",
   :type :formula,
   :show? false,
   :position {:x 240, :y 540},
   :code "(fn []\n  (persons))"}
  {:id "bars-plot",
   :label "rtable (bars)",
   :type :formula,
   :show? true,
   :position {:x 560, :y 60},
   :code "(fn [ctx data]\n  ((requiring-resolve 'itera.plot.rtable/rtable) data))",
   :spec
   {:row-height "1.8rem",
    :columns
    [{:path :date, :header "Date", :width 120, :format :format-date}
     {:path :close, :header "Close", :format :nr-format-auto}
     {:path :volume, :header "Volume", :format :nr-format-auto}]}}
  {:id "simple-plot",
   :label "rtable (simple)",
   :type :formula,
   :show? true,
   :position {:x 560, :y 300},
   :code "(fn [ctx data]\n  ((requiring-resolve 'itera.plot.rtable/rtable) data))",
   :spec {:row-height "1.8rem", :columns [{:path :close, :header "Close"} {:path :sma, :header "SMA"}]}}
  {:id "persons-plot",
   :label "rtable (persons)",
   :type :formula,
   :show? true,
   :position {:x 560, :y 540},
   :code "(fn [ctx data]\n  ((requiring-resolve 'itera.plot.rtable/rtable) data))",
   :spec
   {:row-height "1.8rem",
    :columns
    [{:path :id, :header "ID", :width 60}
     {:path :first-name, :header "First", :width 100}
     {:path :last-name, :header "Last", :width 100}
     {:path :age, :header "Age", :width 60, :format :nr-format-auto, :style-fn :age-color}
     {:path :sex, :header "Sex", :width 80, :format :sex-icon}
     {:path :desc, :header "Description", :max-width "240px"}]}}],
 :edges
 [{:id "e-bars", :source-node "bars-data", :source-port "out", :target-node "bars-plot", :target-port "data"}
  {:id "e-simple",
   :source-node "simple-data",
   :source-port "out",
   :target-node "simple-plot",
   :target-port "data"}
  {:id "e-persons",
   :source-node "persons-data",
   :source-port "out",
   :target-node "persons-plot",
   :target-port "data"}]}
