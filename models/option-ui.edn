    {:path [:count], :type :int, :name "count"}
    {:path [:ratio], :type :double, :name "ratio"}
    {:type :label,
     :name "Selects (single & multiple)"}
    {:path [:asset], :type :select, :name "asset", :spec "[:AAPL :MSFT :GOOGL]"}
    {:path [:frequency],
     :type :select,
     :name "frequency",
     :spec "[{:id :m1, :name \"1 minute\"} {:id :m5, :name \"5 minutes\"} {:id :d1, :name \"1 day\"}]"}
    {:path [:color], :type :select, :name "color", :spec "(sort (keys colors))"}
