(defn get-inputs [workbook-ns code]
  (let [{:keys [value]} (compile workbook-ns code)]
    (if (and value (fn? value))
      (->> (fn-arglist code)
           (remove (contains? #{'_ 'ctx}))
       )
      
      [])))
